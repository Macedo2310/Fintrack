# Copie este arquivo para .env apenas no desenvolvimento local.
# Em produção, use as variáveis de ambiente da hospedagem com disco persistente.
# NUNCA coloque chaves reais neste arquivo.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=60
# Em HTTPS/produção, altere para 1.
COOKIE_SECURE=0
APP_BASE_URL=http://127.0.0.1:8010
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=
RECEIPT_ANALYZER_URL=
RECEIPT_ANALYZER_KEY=

# Segurança/limites
MAX_MONEY_CENTS=100000000000
# Se preenchido, novos cadastros de professor precisam informar este código.
PROFESSOR_SIGNUP_CODE=

# Diretório persistente opcional. Sem valor, usa ./data.
# FINTRACK_DATA_DIR=D:/FinTrack/data
