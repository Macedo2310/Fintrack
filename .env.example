# Copie para .env apenas no desenvolvimento local. Em produção, use as variáveis
# de ambiente da hospedagem. NUNCA coloque chaves reais neste arquivo nem no repositório.

# --- Backend: "supabase" usa app_supabase.py (Supabase Auth, banco e Storage); vazio = app.py com SQLite local ---
FINTRACK_BACKEND=supabase
SUPABASE_URL=https://chzaruypbunxuhftpymj.supabase.co
# Chave publicável (pode ser pública; o RLS protege os dados).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_JLk623l5Y9qYN8N10Ku-rw_UolwJ4XZ
# Chave SECRETA (sb_secret_… ou service_role). Só no servidor; nunca no navegador nem no repositório.
# Dashboard → Project Settings → API Keys. Sem ela: sem fotos, comprovantes, resposta da IA, indicadores e resumo semanal.
SUPABASE_SECRET_KEY=
# 1 depois de ativar o provedor Google em Authentication → Providers.
FINTRACK_GOOGLE_ENABLED=0

# --- Obrigatórias em produção ---
# Pasta em disco PERSISTENTE para banco e uploads (sem valor: ./data).
# FINTRACK_DATA_DIR=/var/lib/fintrack
# Em HTTPS/produção, use 1 (cookie de sessão só trafega por HTTPS).
COOKIE_SECURE=0
APP_BASE_URL=http://127.0.0.1:8010
# HOST=127.0.0.1
# PORT=8010
# Atrás de proxy reverso (Nginx/Caddy): IP(s) do proxy, separados por vírgula.
# Só conexões vindas deles podem informar o IP real por X-Forwarded-For (usado nos limites de tentativa).
# FORWARDED_ALLOW_IPS=127.0.0.1

# --- Opcionais: IA do FinBot (sem isto, a interface informa "IA indisponível") ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_SECONDS=60
# Alternativa: provedor compatível com /chat/completions
AI_PROVIDER_URL=
AI_API_KEY=
AI_MODEL=

# --- Opcionais: e-mail (recuperação de senha e resumo semanal) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Opcional: login com Google (OAuth 2.0 / OpenID Connect) ---
# Crie um "ID do cliente OAuth" do tipo "Aplicativo da Web" no Google Cloud Console.
# URI de redirecionamento autorizado: APP_BASE_URL + /api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Opcional: leitura de comprovantes (serviço externo que devolve JSON) ---
RECEIPT_ANALYZER_URL=
RECEIPT_ANALYZER_KEY=

# --- Segurança e operação ---
MAX_MONEY_CENTS=100000000000
# Se preenchido, novos cadastros de professor precisam informar este código.
PROFESSOR_SIGNUP_CODE=
LOG_LEVEL=INFO
# 1 desativa o worker de recorrências/resumos (use só em testes ou se houver agendador externo).
# FINTRACK_DISABLE_WORKER=0
